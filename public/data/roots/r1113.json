{"id":"r1113","r":"فسد","letters":["ف","س","د"],"verbs":[{"lem":"فَسَدَتِ","form":1,"count":3,"forms":[{"w":"فَسَدَتِ","t":"PERF","p":"3FS","v":"ACT","m":"","locs":["2:251:20","23:71:5"]},{"w":"فَسَدَتَا","t":"PERF","p":"3FD","v":"ACT","m":"","locs":["21:22:7"]}]},{"lem":"أَفْسَدُ","form":4,"count":15,"forms":[{"w":"يُفْسِدُونَ","t":"IMPF","p":"3MP","v":"ACT","m":"IND","locs":["2:27:15","13:25:15","16:88:13","26:152:2","27:48:6"]},{"w":"تُفْسِدُوا۟","t":"IMPF","p":"2MP","v":"ACT","m":"JUS","locs":["2:11:5","7:56:2","7:85:27"]},{"w":"يُفْسِدُ","t":"IMPF","p":"3MS","v":"ACT","m":"IND","locs":["2:30:14"]},{"w":"يُفْسِدَ","t":"IMPF","p":"3MS","v":"ACT","m":"SUBJ","locs":["2:205:6"]},{"w":"يُفْسِدُوا۟","t":"IMPF","p":"3MP","v":"ACT","m":"SUBJ","locs":["7:127:9"]},{"w":"نُفْسِدَ","t":"IMPF","p":"1P","v":"ACT","m":"SUBJ","locs":["12:73:7"]},{"w":"تُفْسِدُنَّ","t":"IMPF","p":"2MP","v":"ACT","m":"IND","locs":["17:4:7"]},{"w":"أَفْسَدُو","t":"PERF","p":"3MP","v":"ACT","m":"","locs":["27:34:7"]},{"w":"تُفْسِدُوا۟","t":"IMPF","p":"2MP","v":"ACT","m":"SUBJ","locs":["47:22:6"]}]}],"nouns":[{"lem":"مُفْسِد","pos":"ACT_PCPL","form":4,"count":21,"locs":["2:12:4","2:60:28","2:220:16","3:63:6","5:64:47","7:74:25","7:86:24","7:103:16","7:142:23","10:40:12","10:81:17","10:91:7","11:85:14","18:94:7","26:183:9","27:14:11","28:4:19","28:77:26","29:30:6","29:36:16","38:28:7"]},{"lem":"فَساد","pos":"N","form":null,"count":11,"locs":["2:205:14","5:32:15","5:33:10","5:64:43","8:73:12","11:116:11","28:77:19","28:83:12","30:41:2","40:26:18","89:12:3"]}],"maqayis":"الفاء والسين والدال كلمة واحدة، فسد الشيء يفسد فسادا وفسودا، وهو فاسد وفسيد","maqayis_ed":"shamela","mufradat":"الفساد: خروج الشيء عن الاعتدال، قليلا كان الخروج عنه أو كثيرا، ويضاده الصلاح، ويستعمل ذلك في النفس، والبدن، والأشياء الخارجة عن الاستقامة، يقال: فسد فسادا وفسودا، وأفسده غيره. قال تعالى: لفسدت السماوات والأرض المؤمنون/ 71، لو كان فيهما آلهة إلا الله لفسدتا الأنبياء/ 22، ظهر الفساد في البر والبحر الروم/ 41، والله لا يحب الفساد البقرة/ 205، وإذا قيل لهم لا تفسدوا في الأرض البقرة/ 11، ألا إنهم هم المفسدون البقرة/ 12، ليفسد فيها ويهلك الحرث والنسل البقرة/ 205، إن الملوك إذا دخلوا قرية أفسدوها النمل/ 34، إن الله لا يصلح عمل المفسدين يونس/ 81، والله يعلم المفسد من المصلح البقرة/ 220","mufradat_ed":"masaha"}