{"id":"r1286","r":"كود","letters":["ك","و","د"],"verbs":[{"lem":"كادَ","form":1,"count":24,"forms":[{"w":"يَكَادُ","t":"IMPF","p":"3MS","v":"ACT","m":"IND","locs":["2:20:1","14:17:3","24:35:26","24:43:34","43:52:10","68:51:2"]},{"w":"كَادُوا۟","t":"PERF","p":"3MP","v":"ACT","m":"","locs":["2:71:23","7:150:29","17:73:2","17:76:2","72:19:7"]},{"w":"يَكَادُونَ","t":"IMPF","p":"3MP","v":"ACT","m":"IND","locs":["4:78:34","18:93:11","22:72:12"]},{"w":"تَكَادُ","t":"IMPF","p":"3FS","v":"ACT","m":"IND","locs":["19:90:1","42:5:1","67:8:1"]},{"w":"كَادَ","t":"PERF","p":"3MS","v":"ACT","m":"","locs":["9:117:16","25:42:2"]},{"w":"كِدتَّ","t":"PERF","p":"2MS","v":"ACT","m":"","locs":["17:74:5","37:56:4"]},{"w":"أَكَادُ","t":"IMPF","p":"1S","v":"ACT","m":"IND","locs":["20:15:4"]},{"w":"يَكَدْ","t":"IMPF","p":"3MS","v":"ACT","m":"JUS","locs":["24:40:22"]},{"w":"كَادَتْ","t":"PERF","p":"3FS","v":"ACT","m":"","locs":["28:10:7"]}]}],"nouns":[],"maqayis":"الكاف والواو والدال كلمة كأنها تدل على التماس شيء ببعض العناء. يقولون: كاد يكود كودا ومكادا. ويقولون لمن يطلب منك الشيء فلا تريد إعطاءه: لا ولا مكادة. فأما قولهم في المقاربة: كاد، فمعناها قارب. وإذا وقعت كاد مجردة فلم يقع ذلك الشيء تقول: كاد يفعل، فهذا لم يفعل، وإذا قرنت بجحد فقد وقع، إذا قلت ما كاد يفعله فقد فعله. قال الله سبحانه: {فذبحوها وما كادوا يفعلون} البقرة: 71","maqayis_ed":"shamela","mufradat":null,"mufradat_ed":null}